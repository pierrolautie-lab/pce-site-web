{
  "name": "pce-site-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site vitrine PCE — plomberie, chauffage, climatisation, electricite, piscine — Lorgues (83)",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-images.js && node scripts/generate-sitemap.js && vite build && node scripts/prerender.js && node scripts/cache-bust.js",
    "preview": "vite preview",
    "verify:live": "node scripts/verify-live.js",
    "check:images": "node scripts/verify-images.js",
    "check:typo": "node scripts/typo.cjs",
    "fix:typo": "node scripts/typo.cjs --write",
    "check:spell": "node scripts/spellcheck.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@prerenderer/prerenderer": "^1.2.5",
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "dictionary-fr": "^3.0.0",
    "nspell": "^2.1.5",
    "postcss": "^8.4.47",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
