# ModSecurity (Hostinger) bloquait toutes les requêtes vers pcevar.fr avec
# un 403 muet (rien dans les journaux standards) à cause de deux règles
# précises — confirmé et corrigé par le support Hostinger. Le nom exact du
# module (mod_security.c vs mod_security2.c selon la version) n'étant pas
# garanti sur LiteSpeed, on couvre les deux pour être sûr que le bloc
# s'applique réellement.
<IfModule mod_security.c>
  SecRuleRemoveById 400011
  SecRuleRemoveById 400012
</IfModule>
<IfModule mod_security2.c>
  SecRuleRemoveById 400011
  SecRuleRemoveById 400012
</IfModule>

# Site à page unique (React Router) : toute URL qui ne correspond pas à un
# fichier réel doit être servie par index.html, pour que le routage côté
# client prenne le relais (ex : /chauffage rechargé directement dans le
# navigateur, sans passer par la navigation interne du site).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Laisse passer les fichiers et dossiers qui existent réellement
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  RewriteRule ^ index.html [L]
</IfModule>

# Compression et mise en cache basique des ressources statiques
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
