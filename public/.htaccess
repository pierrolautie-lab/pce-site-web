# ModSecurity (Hostinger) bloquait toutes les requêtes vers pcevar.fr avec
# un 403 muet (rien dans les journaux standards) à cause de deux règles
# précises — confirmé et corrigé par le support Hostinger. Le nom exact du
# module (mod_security.c vs mod_security2.c selon la version) n'étant pas
# garanti sur LiteSpeed, on couvre les deux pour être sûr que le bloc
# s'applique réellement.
<IfModule mod_security.c>
  SecRuleRemoveById 400011
  SecRuleRemoveById 400012
</IfModule>
<IfModule mod_security2.c>
  SecRuleRemoveById 400011
  SecRuleRemoveById 400012
</IfModule>

# Site prérendu (voir scripts/prerender.js) : chaque route déclarée dans les
# sitemaps a son propre dossier avec un index.html complet dans dist/, ex.
# /plombier-lorgues -> plombier-lorgues/index.html. On sert ce fichier
# directement, SANS passer par la redirection 301 qu'Apache ajoute
# normalement pour une URL de dossier sans slash final (mod_dir) : les URL
# canoniques déclarées partout sur le site (sitemaps, <link rel=canonical>,
# liens internes) n'ont pas de slash final, la redirection les contredirait.
# Seule une URL réellement inconnue retombe sur la coquille SPA (React
# Router y affiche alors la page 404 côté client).
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Fichier réel demandé tel quel (assets, images, sitemap...)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Page prérendue : /plombier-lorgues -> /plombier-lorgues/index.html, sans redirection
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]

  # URL vraiment inconnue : coquille SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Compression et mise en cache basique des ressources statiques
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>


# Un an de cache pour tout ce qui est versionné par son nom de fichier.
# L'incident qui avait motivé des durées courtes (une réponse transitoire
# mise en cache jusqu'à un mois) concernait des réponses HTML servies par
# un cache de plateforme — le HTML, lui, reste en no-cache strict (bloc
# mod_headers ci-dessous) et LSCache reste désactivé : c'est cette paire-là
# qui protège les déploiements, pas la durée de vie des assets.
#   - /assets/*.js et *.css : empreinte de contenu dans le nom (Vite) + ?v=
#     de cache-bust.js — un nouveau build produit de nouvelles URL, l'ancien
#     cache ne peut jamais être servi à tort. `immutable` en prime.
#   - polices woff2 : mêmes assets empreintés par Vite.
#   - images : pas d'empreinte dans le nom, MAIS la pratique du projet est
#     de ne jamais réutiliser un nom de fichier pour un autre visuel (chaque
#     remplacement de photo introduit un nouveau nom + variantes régénérées,
#     voir l'historique dans src/data/photos.js). Si cette pratique changeait
#     un jour, redescendre cette durée en même temps.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Le cache pleine-page LiteSpeed (LSCache, activé par défaut sur Hostinger)
# a été surpris en train de servir une version d'index.html vieille d'un
# déploiement entier, ainsi qu'une réponse "page introuvable" mise en cache
# pour robots.txt/manifest.json/sitemap-index.xml — probablement parce que
# ces fichiers ont été explorés une première fois avant d'exister, et que la
# réponse (SPA + 200 OK) a été mise en cache comme si elle était correcte.
# On désactive donc entièrement ce cache pleine-page pour le site : une SPA
# React n'a de toute façon rien à gagner à ce qu'index.html soit mis en
# cache côté serveur, alors que les risques de contenu périmé sont réels.
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # `immutable` réservé aux fichiers à empreinte de contenu (bundle Vite,
  # polices) : le navigateur ne revalide jamais, même sur un rechargement.
  # Pas sur les images, dont le nom n'est pas garanti par un hash.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
